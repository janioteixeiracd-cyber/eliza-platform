# ============================================================================
# ELIZA INTELLIGENCE LAYER CONFIGURATION
# ============================================================================

# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ============================================================================
# SERVER
# ============================================================================

PORT=3000
NODE_ENV=development

# ============================================================================
# FIREBASE
# ============================================================================

# Firebase Admin SDK (server-side)
GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json

# Firebase Client Config (if using client SDK in frontend)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================================================
# ELIZA INTELLIGENCE LAYER
# ============================================================================

# JWT Secret (change this in production!)
ELIZA_JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# AI Providers
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# ============================================================================
# WHATSAPP INTEGRATION
# ============================================================================

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_BUSINESS_PHONE_NUMBER=your_business_phone_number
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ============================================================================
# GOOGLE CLOUD
# ============================================================================

GCP_PROJECT_ID=your-project-id
GCP_SECRET_MANAGER_ENABLED=false

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=info
DEBUG=false

# ============================================================================
# FRONTEND (if needed)
# ============================================================================

VITE_API_BASE_URL=http://localhost:3000
VITE_ELIZA_TOKEN_STORAGE_KEY=eliza_token
